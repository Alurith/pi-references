{
  "name": "pi-references",
  "version": "0.3.0",
  "description": "Pi extension that implements OpenCode-style references",
  "license": "MIT",
  "files": [
    "index.ts",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alurith/pi-references.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "references"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "^22.20.1",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  }
}
